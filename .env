# Mongo root user (used only during init)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=supersecret

# Application database
MONGO_DB_NAME=myapp

# Application user
MONGO_APP_USERNAME=appuser
MONGO_APP_PASSWORD=apppassword

# Connection URI (used by NestJS)
MONGODB_URI=mongodb://${MONGO_APP_USERNAME}:${MONGO_APP_PASSWORD}@mongo:27017/${MONGO_DB_NAME}?authSource=admin
